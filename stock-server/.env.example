# InvestAI 本地模型配置模板
#
# 复制为 .env 后填入真实凭据：
#   cp .env.example .env
#
# 本文件会被 bun run 自动加载（项目根目录）。.env 已被 .gitignore 忽略，
# 不会提交到仓库。
#
# 所有键都带 INVEST_ 前缀，由 compat/preload.ts 在启动时映射为 CLI 认识的
# ANTHROPIC_* / STOCK_* 变量 —— 这样不会与 shell 或全局 StockAssistant
# 配置里的同名变量冲突。
#
# IMPORTANT
# 设置 INVEST_STOCK_PROVIDER_MANAGED_BY_HOST=1 后，CLI 会忽略
# ~/.stock/settings.json 里与模型路由相关的 env（base URL、token、
# 模型名等），改为以本项目 .env / 进程环境变量为准 —— 这样工程不依赖
# 全局 StockAssistant 配置。若不需要此行为，删除该行即可回退。
#
# 注意：Bun 加载 .env 时不会覆盖 shell 中已存在的同名 INVEST_* 变量；
# 需要临时覆盖时，直接 export INVEST_ANTHROPIC_BASE_URL=... 即可。
INVEST_STOCK_PROVIDER_MANAGED_BY_HOST=1

# Anthropic 兼容端点（示例为 MiniMax 的 Anthropic 兼容接口）
INVEST_ANTHROPIC_BASE_URL=https://api.minimax.cn/anthropic
INVEST_ANTHROPIC_AUTH_TOKEN=your-token-here

# 模型映射
INVEST_ANTHROPIC_MODEL=MiniMax-M3.1-Flash[1M]
INVEST_ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3.1-Flash[1M]
INVEST_ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3[1M]
INVEST_ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3.1-Flash[1M]

# 可选：Auto mode server 开关
INVEST_STOCK_AUTO_MODE_SERVER=0

# 可选：自动压缩窗口（token 数）
INVEST_STOCK_AUTO_COMPACT_WINDOW=1000000
