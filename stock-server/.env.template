OPENAI_API_KEY=your-api-key
OPENAI_API_BASE=http://localhost:11434/v1
CHAT_MODEL=qwen3.5:4b

# 可选：LLM 调用重试与超时（429/5xx 由 OpenAI SDK 自动退避重试）
OPENAI_MAX_RETRIES=5
OPENAI_TIMEOUT_SECONDS=120

# 可选：会话记录保留策略
# 对话在最后一次消息之后保留的天数；设为 0 关闭自动清理。
STOCK_HISTORY_RETENTION_DAYS=90
# 清理任务的执行间隔（小时）。
STOCK_HISTORY_CLEANUP_HOURS=24

# 可选：会话数据（checkpoint 与消息）的 SQLite 位置
# 默认 stock-server/data/checkpoints.db；设为 :memory: 则不做持久化。
# STOCK_CHECKPOINT_DB=D:\project\StockAssistant\stock-server\data\checkpoints.db
